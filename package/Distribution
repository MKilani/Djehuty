<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>Djehuty-@VERSION@</title>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <pkg-ref id="io.github.mkilani.inputmethod.Djehuty"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="12.0"/>
        </allowed-os-versions>
    </volume-check>
    <options customize="never" hostArchitectures="arm64,x86_64" require-scripts="false" rootVolumeOnly="true"/>
    <choices-outline>
        <line choice="default">
            <line choice="io.github.mkilani.inputmethod.Djehuty"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="io.github.mkilani.inputmethod.Djehuty" visible="false">
        <pkg-ref id="io.github.mkilani.inputmethod.Djehuty"/>
    </choice>
    <pkg-ref id="io.github.mkilani.inputmethod.Djehuty" onConclusion="RequireLogout">Djehuty-component.pkg</pkg-ref>
</installer-gui-script>
